#!/bin/bash
# Schemail Classifier Wrapper
# Simplifies running the classifier with sane defaults

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCHEMAIL="${SCRIPT_DIR}/schemail"

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Show usage
usage() {
    cat <<EOF
Usage: classify [N] [--live] [--model MODEL]

Classify N emails from your inbox using Experiment 3 (flat labels).

Arguments:
  N             Number of emails to process (default: 10)
  --live        Actually apply labels and archive (default: dry-run)
  --model MODEL LLM model to use (default: haiku-4-5)
                  haiku-4-5  = Fast, cheap (~\$0.0006/email)
                  sonnet-4-5 = Smart, expensive (~\$0.10/email)

Examples:
  classify                    # Dry-run on last 10 emails (Haiku)
  classify 50                 # Dry-run on last 50 emails (Haiku)
  classify 50 --live          # Process 50 emails (Haiku, apply labels)
  classify 200 --live         # Process 200 emails (Haiku)
  classify 10 --model sonnet-4-5 --live  # Use Sonnet for new emails

Default mode is DRY-RUN (safe). Use --live to actually modify emails.
Default model is Haiku 4.5 (cheap). Use Sonnet for better quality on small batches.

Classifier: experiment-3 (Inbox Zero framework with flat labels)
Color scheme: rainbow (applied automatically at end)
Query: in:inbox -label:Schemail (only unprocessed emails)

EOF
    exit 0
}

# Parse arguments
N=10
LIVE=""
MODEL="haiku-4-5"

if [[ "${1:-}" == "-h" ]] || [[ "${1:-}" == "--help" ]]; then
    usage
fi

# Parse all arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --live|-l)
            LIVE="--execute"
            shift
            ;;
        --model)
            MODEL="$2"
            shift 2
            ;;
        [0-9]*)
            N="$1"
            shift
            ;;
        *)
            echo "Unknown option: $1"
            usage
            ;;
    esac
done

if [[ -n "$LIVE" ]]; then
    echo -e "${YELLOW}⚠ LIVE MODE: Will modify emails!${NC}"
    echo -e "  Model: ${MODEL}"
    echo ""
else
    echo -e "${GREEN}🔒 DRY-RUN MODE: Safe, no changes will be made${NC}"
    echo -e "  Model: ${MODEL}"
    echo ""
fi

# Run classifier
exec "$SCHEMAIL" process \
    --last "$N" \
    --classifier experiment-3 \
    --model "$MODEL" \
    $LIVE \
    2>&1 | tee "/tmp/schemail-classify-$(date +%Y%m%d-%H%M%S).log"
