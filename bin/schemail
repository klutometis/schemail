#!/usr/bin/env racket
#lang racket

;; schemail - CLI for LLM-powered email filtering

(require "../src/oauth.rkt"
         "../src/gmail.rkt"
         "../src/filters.rkt"
         "../src/llm-classifier.rkt"
         "../src/label-colors.rkt"
         "../src/label-utils.rkt"
         "../config/filters.rkt"
         "../config/preferences.rkt"
         "../config/classifier-prompts.rkt"
         "../config/schemail.rkt")

;; ============================================================================
;; CLI Argument Parsing
;; ============================================================================

(define (show-help)
  (displayln "
╔════════════════════════════════════════════════════════════╗
║                                                            ║
║  schemail - Intelligent Email Filtering                   ║
║                                                            ║
╚════════════════════════════════════════════════════════════╝

USAGE:
  schemail process [OPTIONS]     Process emails through filters
  schemail daemon [OPTIONS]      Run as daemon (polls for new emails)
  schemail labels [OPTIONS]      Manage Gmail labels
  schemail test                  Run test suite
  schemail help                  Show this help

PROCESS OPTIONS:
  --last N                  Process last N emails (default: 10)
  --unread                  Process only unread emails
  --since DATE              Process emails since date (YYYY-MM-DD)
  --until DATE              Process emails until date (YYYY-MM-DD)
  --query QUERY             Custom Gmail query
                            Default: in:inbox -label:Schemail (unprocessed only)
  
  --filter STRATEGY         Filter strategy to use (default: hybrid)
                            Options: hybrid, pure-llm, selective-llm
  
  --classifier EXPERIMENT   Use structured classifier instead of filters
                            Options: experiment-1, experiment-2, experiment-3
  
  --color-scheme SCHEME     Color scheme for labels (overrides config)
                            Options: set1, muted, bright, rainbow, none
                            Applies colors at end of process run
  
  --execute                 Actually execute actions (default: dry-run)
  --dry-run                 Only show what would happen (default)
  
  --include-processed       Include already-processed emails (has Schemail label)
  --interactive             Interactively review each email
  --verbose                 Show detailed output

DAEMON OPTIONS:
  --interval N              Poll interval in minutes (default: 5)
  --query \"QUERY\"           Gmail query for emails to process

LABELS OPTIONS:
  hide-except PREFIX        Hide all labels except those starting with PREFIX
                            Example: schemail labels hide-except Schemail
  
  assign-colors             Apply color scheme to all user labels
                            Uses scheme from config or --color-scheme flag
  
  cleanup                   Delete all experiment labels (keeps excluded labels)
                            Useful for cleaning up between experiments

EXAMPLES:
  # Dry-run on last 10 emails (safe)
  schemail process --last 10
  
  # Actually process last 50 emails with hybrid strategy
  schemail process --last 50 --filter hybrid --execute
  
  # Test structured classifier experiments (on unprocessed emails)
  schemail process --last 50 --classifier experiment-1
  schemail process --last 50 --classifier experiment-2
  schemail process --last 50 --classifier experiment-3
  
  # Reprocess all emails (including already processed)
  schemail process --last 50 --classifier experiment-1 --include-processed
  
  # Process unread emails only
  schemail process --unread --execute
  
  # Process emails from last week
  schemail process --since \"2026-02-07\" --execute
  
  # Interactive mode (review each email)
  schemail process --last 20 --interactive
  
  # Run as daemon (checks every 5 minutes)
  schemail daemon --interval 5

FILTER STRATEGIES:
  hybrid       - Fast pattern matching + LLM fallback (recommended)
  pure-llm     - LLM processes every email (slow, expensive)
  selective-llm - Pattern matching first, LLM only for ambiguous cases

LABEL STRUCTURE:
  - Flat labels: Receipt, Newsletter, Shipping (visible, colorful)
  - Hidden marker: Schemail (marks email as processed, hidden from sidebar)
  - Both applied together by model
  - Query -label:Schemail finds unprocessed emails

NOTES:
  - Default mode is DRY-RUN for safety
  - Use --execute to actually modify emails
  - First run will trigger OAuth flow
  - Costs ~$0.007 per email with LLM (~$20/month for 100/day)
")
  (exit 0))

;; Parse command-line arguments
(define (parse-args args)
  (define options (make-hash))
  (hash-set! options 'command #f)
  (hash-set! options 'last 10)
  (hash-set! options 'dry-run? #t)
  (hash-set! options 'filter 'hybrid)
  (hash-set! options 'classifier #f)
  (hash-set! options 'unread? #f)
  (hash-set! options 'interactive? #f)
  (hash-set! options 'verbose? #f)
  (hash-set! options 'interval 5)
  (hash-set! options 'query #f)
  (hash-set! options 'since #f)
  (hash-set! options 'until #f)
  (hash-set! options 'include-processed? #f)
  (hash-set! options 'color-scheme #f)
  
  (let loop ([args args])
    (match args
      ['() options]
      
      ;; Commands
      [(list "help" rest ...)
       (show-help)]
      [(list "process" rest ...)
       (hash-set! options 'command 'process)
       (loop rest)]
      [(list "daemon" rest ...)
       (hash-set! options 'command 'daemon)
       (loop rest)]
      [(list "test" rest ...)
       (hash-set! options 'command 'test)
       (loop rest)]
      [(list "labels" "hide-except" prefix rest ...)
       (hash-set! options 'command 'labels-hide-except)
       (hash-set! options 'label-prefix prefix)
       (loop rest)]
      [(list "labels" "assign-colors" rest ...)
       (hash-set! options 'command 'labels-assign-colors)
       (loop rest)]
      [(list "labels" "cleanup" rest ...)
       (hash-set! options 'command 'labels-cleanup)
       (loop rest)]
      
      ;; Options
      [(list "--last" n rest ...)
       (hash-set! options 'last (string->number n))
       (loop rest)]
      [(list "--unread" rest ...)
       (hash-set! options 'unread? #t)
       (loop rest)]
      [(list "--since" date rest ...)
       (hash-set! options 'since date)
       (loop rest)]
      [(list "--until" date rest ...)
       (hash-set! options 'until date)
       (loop rest)]
      [(list "--query" q rest ...)
       (hash-set! options 'query q)
       (loop rest)]
      [(list "--filter" strategy rest ...)
       (hash-set! options 'filter (string->symbol strategy))
       (loop rest)]
      [(list "--classifier" experiment rest ...)
       (hash-set! options 'classifier (string->symbol experiment))
       (loop rest)]
      [(list "--color-scheme" scheme rest ...)
       (define scheme-sym (string->symbol scheme))
       (hash-set! options 'color-scheme (if (eq? scheme-sym 'none) #f scheme-sym))
       (loop rest)]
      [(list "--execute" rest ...)
       (hash-set! options 'dry-run? #f)
       (loop rest)]
      [(list "--dry-run" rest ...)
       (hash-set! options 'dry-run? #t)
       (loop rest)]
      [(list "--interactive" rest ...)
       (hash-set! options 'interactive? #t)
       (loop rest)]
      [(list "--include-processed" rest ...)
       (hash-set! options 'include-processed? #t)
       (loop rest)]
      [(list "--verbose" rest ...)
       (hash-set! options 'verbose? #t)
       (loop rest)]
      [(list "--interval" n rest ...)
       (hash-set! options 'interval (string->number n))
       (loop rest)]
      
      [else
       (displayln (format "Unknown option: ~a" (car args)))
       (displayln "Run 'schemail help' for usage.")
       (exit 1)]))
  
  options)

;; ============================================================================
;; Commands
;; ============================================================================

;; Process emails through filters
(define (cmd-process options)
  (displayln "\n╔════════════════════════════════════════════════════════════╗")
  (displayln "║  Processing Emails                                         ║")
  (displayln "╚════════════════════════════════════════════════════════════╝\n")
  
  (define dry-run? (hash-ref options 'dry-run?))
  (define filter-strategy (hash-ref options 'filter))
  (define classifier-experiment (hash-ref options 'classifier))
  (define last-n (hash-ref options 'last))
  (define unread? (hash-ref options 'unread?))
  (define user-query (hash-ref options 'query))
  (define since (hash-ref options 'since))
  (define until (hash-ref options 'until))
  (define interactive? (hash-ref options 'interactive?))
  (define include-processed? (hash-ref options 'include-processed?))
  
  (displayln (format "Mode: ~a" (if dry-run? "DRY-RUN (safe)" "LIVE (will modify emails)")))
  (if classifier-experiment
      (displayln (format "Classifier: ~a" classifier-experiment))
      (displayln (format "Filter Strategy: ~a" filter-strategy)))
  (displayln "")
  
  ;; Get Gmail token (will authorize if needed)
  (get-gmail-token)
  
  ;; Build Gmail query
  ;; Default: only unprocessed emails (no Schemail label)
  (define gmail-query
    (cond
      ;; User provided explicit query - use as-is
      [user-query user-query]
      ;; User wants processed emails included
      [include-processed?
       (cond
         [unread? "is:unread"]
         [(and since until) (format "after:~a before:~a" since until)]
         [since (format "after:~a" since)]
         [until (format "before:~a" until)]
         [else #f])]
      ;; Default: exclude processed emails
      [else
       (define base-query
         (cond
           [unread? "is:unread -label:Schemail"]
           [(and since until) (format "after:~a before:~a -label:Schemail" since until)]
           [since (format "after:~a -label:Schemail" since)]
           [until (format "before:~a -label:Schemail" until)]
           [else "in:inbox -label:Schemail"]))
       base-query]))
  
  ;; Fetch messages
  (displayln (format "Fetching ~a emails~a..."
                     (if last-n last-n "all")
                     (if gmail-query (format " (query: ~a)" gmail-query) "")))
  
  (define messages-response 
    (gmail-list-messages #:query gmail-query 
                        #:max-results (or last-n 100)))
  
  (define message-ids 
    (map (λ (m) (hash-ref m 'id))
         (hash-ref messages-response 'messages '())))
  
  (when (empty? message-ids)
    (displayln "No messages found!")
    (exit 0))
  
  (displayln (format "Found ~a message(s)\n" (length message-ids)))
  
  ;; Get classifier prompt if using classifier mode
  (define classifier-prompt
    (and classifier-experiment
         (match classifier-experiment
           ['experiment-1 experiment-1-prompt]
           ['experiment-2 experiment-2-prompt]
           ['experiment-3 experiment-3-prompt]
           [else 
            (displayln (format "Unknown classifier experiment: ~a" classifier-experiment))
            (displayln "Valid options: experiment-1, experiment-2, experiment-3")
            (exit 1)])))
  
  ;; Select filter strategy (if not using classifier)
  (define filters
    (and (not classifier-experiment)
         (match filter-strategy
           ['hybrid filters-hybrid]
           ['pure-llm filters-pure-llm]
           ['selective-llm filters-selective-llm]
           [else 
            (displayln (format "Unknown filter strategy: ~a" filter-strategy))
            (displayln "Using hybrid strategy instead.")
            filters-hybrid])))
  
  ;; Fetch existing labels once at the beginning (for classifier mode)
  (define labels-hash
    (if classifier-prompt
        (let ([exclude-list (get-config 'exclude-from-coloring)])
          (displayln "Fetching existing labels...")
          (get-labels-with-counts #:exclude exclude-list))
        #f))
  
  ;; Process each message
  (for ([id message-ids]
        [i (in-naturals 1)])
    (displayln (format "\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"))
    (displayln (format "MESSAGE ~a/~a" i (length message-ids)))
    (displayln (format "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"))
    
    (define msg (gmail-get-message id))
    
    ;; Interactive mode: ask before processing
    (define should-process?
      (if interactive?
          (let ()
            (displayln "\nPress Enter to process, 's' to skip, 'q' to quit:")
            (define response (read-line))
            (cond
              [(equal? response "q") (exit 0)]
              [(equal? response "s") #f]
              [else #t]))
          #t))
    
    (when should-process?
      (if classifier-prompt
          ;; Use structured classifier with labels hash
          (classify-email msg classifier-prompt labels-hash #:dry-run? dry-run?)
          ;; Use filter strategy
          (process-message-with-filters msg filters #:dry-run? dry-run?))))
  
  (displayln "\n✓ Done processing all messages!")
  
  ;; Apply label colors if configured (and not in dry-run mode)
  (unless dry-run?
    (define color-scheme-override (hash-ref options 'color-scheme #f))
    (define color-scheme (or color-scheme-override (get-config 'color-scheme)))
    (when color-scheme
      ;; Pass labels-hash if we have it (from classifier mode), otherwise let colors fetch
      (if labels-hash
          (apply-label-colors! #:scheme color-scheme #:labels-hash labels-hash)
          (apply-label-colors! #:scheme color-scheme)))))

;; Run as daemon
(define (cmd-daemon options)
  (displayln "\n╔════════════════════════════════════════════════════════════╗")
  (displayln "║  Daemon Mode                                               ║")
  (displayln "╚════════════════════════════════════════════════════════════╝\n")
  
  (define interval-minutes (hash-ref options 'interval))
  (define interval-seconds (* interval-minutes 60))
  (define query (hash-ref options 'query "is:unread"))
  
  (displayln (format "Polling interval: ~a minutes" interval-minutes))
  (displayln (format "Query: ~a" query))
  (displayln "Press Ctrl+C to stop.\n")
  
  ;; Get Gmail token once at startup (will authorize if needed)
  (get-gmail-token)
  
  (let loop ()
    (displayln (format "\n[~a] Checking for new emails..." 
                      (~a (seconds->date (current-seconds)))))
    
    (with-handlers ([exn:fail? 
                     (λ (e)
                       (displayln (format "Error: ~a" (exn-message e)))
                       (displayln "Continuing..."))])
      
      (define messages-response 
        (gmail-list-messages #:query query #:max-results 50))
      
      (define message-ids 
        (map (λ (m) (hash-ref m 'id))
             (hash-ref messages-response 'messages '())))
      
      (if (empty? message-ids)
          (displayln "  No new messages.")
          (begin
            (displayln (format "  Found ~a new message(s), processing..." 
                              (length message-ids)))
            (for ([id message-ids])
              (define msg (gmail-get-message id))
              (process-message-with-filters msg filters-hybrid #:dry-run? #f)))))
    
    (displayln (format "  Sleeping for ~a minutes..." interval-minutes))
    (sleep interval-seconds)
    (loop)))

;; Run test suite
(define (cmd-test options)
  (displayln "\n╔════════════════════════════════════════════════════════════╗")
  (displayln "║  Running Test Suite                                        ║")
  (displayln "╚════════════════════════════════════════════════════════════╝\n")
  
  (system "racket src/test-llm.rkt"))

;; Hide labels except those with prefix
(define (cmd-labels-hide-except options)
  (displayln "\n╔════════════════════════════════════════════════════════════╗")
  (displayln "║  Hide Labels (Keep Visible by Prefix)                     ║")
  (displayln "╚════════════════════════════════════════════════════════════╝\n")
  
  (define prefix (hash-ref options 'label-prefix))
  (displayln (format "Will hide all labels EXCEPT those starting with: ~a" prefix))
  (displayln "")
  
  (get-gmail-token)
  
  (define labels-response (gmail-list-labels))
  (define labels (hash-ref labels-response 'labels '()))
  
  ;; Filter to user labels (not system labels)
  (define user-labels
    (filter (λ (label)
              (not (equal? (hash-ref label 'type "user") "system")))
            labels))
  
  (define to-hide
    (filter (λ (label)
              (define name (hash-ref label 'name))
              (not (string-prefix? name prefix)))
            user-labels))
  
  (displayln (format "Found ~a labels to hide:\n" (length to-hide)))
  
  (for ([label to-hide])
    (define name (hash-ref label 'name))
    (define id (hash-ref label 'id))
    (displayln (format "  - ~a" name)))
  
  (displayln "\nProceed? (yes/no)")
  (display "> ")
  (flush-output)
  (define response (read-line))
  
  (if (equal? response "yes")
      (begin
        (displayln "\nHiding labels...")
        (for ([label to-hide])
          (define name (hash-ref label 'name))
          (define id (hash-ref label 'id))
          (displayln (format "  Hiding: ~a" name))
          (gmail-update-label id #:label-list-visibility "labelHide"))
        (displayln "\n✓ Done! Labels are now hidden from sidebar."))
      (displayln "\nCancelled. No changes made.")))

;; Assign colors to labels
(define (cmd-labels-assign-colors options)
  (displayln "\n╔════════════════════════════════════════════════════════════╗")
  (displayln "║  Assign Label Colors                                       ║")
  (displayln "╚════════════════════════════════════════════════════════════╝\n")
  
  (get-gmail-token)
  
  (define color-scheme-override (hash-ref options 'color-scheme #f))
  (define color-scheme (or color-scheme-override (get-config 'color-scheme)))
  
  (unless color-scheme
    (displayln "Error: No color scheme configured.")
    (displayln "Set color-scheme in config/schemail.rkt or use --color-scheme flag.")
    (displayln "")
    (displayln "Available schemes:")
    (displayln "  ColorBrewer: set1 (9), set2 (8), set3 (12), paired (12)")
    (displayln "  Paul Tol:    bright (7), muted (9), vibrant (7), light (9)")
    (displayln "  Dynamic:     rainbow (unlimited)")
    (exit 1))
  
  (apply-label-colors! #:scheme color-scheme))

;; Cleanup experiment labels
(define (cmd-labels-cleanup options)
  (displayln "\n╔════════════════════════════════════════════════════════════╗")
  (displayln "║  Cleanup Experiment Labels                                 ║")
  (displayln "╚════════════════════════════════════════════════════════════╝\n")
  
  (get-gmail-token)
  (cleanup-experiment-labels!))

;; ============================================================================
;; Main Entry Point
;; ============================================================================

(define (main args)
  (when (or (empty? args) 
            (member (car args) '("--help" "-h" "help")))
    (show-help))
  
  (define options (parse-args args))
  (define command (hash-ref options 'command))
  
  (unless command
    (displayln "Error: No command specified.")
    (displayln "Run 'schemail help' for usage.")
    (exit 1))
  
  (match command
    ['process (cmd-process options)]
    ['daemon (cmd-daemon options)]
    ['labels-hide-except (cmd-labels-hide-except options)]
    ['labels-assign-colors (cmd-labels-assign-colors options)]
    ['labels-cleanup (cmd-labels-cleanup options)]
    ['test (cmd-test options)]
    [else 
     (displayln (format "Unknown command: ~a" command))
     (exit 1)]))

;; Run if executed directly
(module+ main
  (main (vector->list (current-command-line-arguments))))
