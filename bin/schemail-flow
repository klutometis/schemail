#!/usr/bin/env racket
#lang racket

;; schemail-flow - Interactive email processing with AI replies

(require "../src/oauth.rkt"
         "../src/gmail.rkt"
         "../src/email-sender.rkt"
         "../src/reply-drafter.rkt"
         "../src/llm-classifier.rkt"
         "../src/people.rkt")

;; Configuration
(define user-name #f)  ; Will be passed to AI if set
(define batch-size 50)

;; Clear screen (Unix-only for now)
(define (clear-screen)
  (system "clear"))

;; Get single keypress
(define (read-key)
  (system "stty raw -echo")
  (define key (read-char))
  (system "stty -raw echo")
  key)

;; Get the address the email was delivered to (handles To/Cc/Bcc correctly)
(define (message-delivered-to message)
  (message-header message "Delivered-To"))

;; Extract bare email address from a header value that may contain a display name
;; e.g. "Alice Example <alice@example.com>" -> "alice@example.com"
;;      "alice@example.com"                  -> "alice@example.com"
(define (extract-address header-value)
  (cond
    [(not header-value) #f]
    [(regexp-match #rx"<([^>]+)>" header-value) => cadr]
    [else (string-trim header-value)]))

;; Split a header containing multiple addresses (comma-separated) into a list
;; Preserves decorated form: "Alice <a@x.com>, Bob <b@y.com>" -> '("Alice <a@x.com>" "Bob <b@y.com>")
;; Bare addresses also work: "a@x.com, b@y.com" -> '("a@x.com" "b@y.com")
(define (split-addresses header-value)
  (if (not header-value)
      '()
      (map string-trim (string-split header-value ","))))

;; Extract bare addresses from a header (for comparison purposes)
(define (extract-addresses header-value)
  (filter-map extract-address (split-addresses header-value)))

;; Display email
(define (display-email msg index total labels)
  (clear-screen)
  (displayln "╔════════════════════════════════════════════════════════════╗")
  (displayln (format "║  Email ~a/~a~a║" 
                     index 
                     total
                     (make-string (max 0 (- 46 (string-length (format "~a" index)) 
                                             (string-length (format "~a" total)))) 
                                 #\space)))
  (displayln "╚════════════════════════════════════════════════════════════╝")
  (displayln "")
  (displayln (format "From:    ~a" (message-from msg)))
  (let ([to (message-header msg "To")])
    (when to (displayln (format "To:      ~a" to))))
  (let ([cc (message-header msg "Cc")])
    (when cc (displayln (format "Cc:      ~a" cc))))
  (displayln (format "Subject: ~a" (message-subject msg)))
  (displayln (format "Date:    ~a" (message-date msg)))
  
  ;; Show existing labels
  (define label-ids (hash-ref msg 'labelIds '()))
  (define user-labels 
    (filter (λ (id) 
              (and (not (member id '("INBOX" "UNREAD" "IMPORTANT" "CATEGORY_PERSONAL")))
                   (not (string-prefix? id "Label_"))))
            label-ids))
  (when (not (empty? user-labels))
    (displayln (format "Labels:  ~a" (string-join 
                                      (map (λ (id) 
                                             (hash-ref labels id id))
                                           user-labels)
                                      ", "))))
  
  (displayln "")
  (displayln "────────────────────────────────────────────────────────────")
  (displayln "")
  
  ;; Show body (truncated)
  (define body (get-email-body msg))
  (if (or (string-contains? body "[No") 
          (string-contains? body "[HTML"))
      ;; Special case: no text or HTML only
      (displayln body)
      ;; Normal: show truncated
      (let ([lines (string-split body "\n")])
        (define display-lines (take lines (min 15 (length lines))))
        (for ([line display-lines])
          (displayln (if (> (string-length line) 70)
                         (string-append (substring line 0 70) "...")
                         line)))
        
        (when (> (length lines) 15)
          (displayln "\n[... message continues ...]"))))
  
  (displayln "")
  (displayln "────────────────────────────────────────────────────────────")
  (displayln "")
  (displayln "Actions:")
  (displayln "  [r] Reply with AI draft    [a] Archive only")
  (displayln "  [s] Skip to next           [q] Quit")
  (displayln "")
  (display "Action: ")
  (flush-output))

;; Display draft reply
(define (display-draft draft envelope)
  (clear-screen)
  (displayln "╔════════════════════════════════════════════════════════════╗")
  (displayln "║  Draft Reply                                               ║")
  (displayln "╚════════════════════════════════════════════════════════════╝")
  (displayln "")
  (displayln (format "  From:    ~a" (hash-ref envelope 'from)))
  (displayln (format "  To:      ~a" (hash-ref envelope 'to)))
  (when (hash-ref envelope 'potential-cc #f)
    (displayln (format "  Cc [a]:  ~a" (hash-ref envelope 'potential-cc))))
  (displayln (format "  Subject: ~a" (hash-ref envelope 'subject)))
  (displayln "")
  (displayln "────────────────────────────────────────────────────────────")
  (displayln "")
  (displayln draft)
  (displayln "")
  (displayln "────────────────────────────────────────────────────────────")
  (displayln "")
  (displayln "Actions:")
  (displayln "  [e] Edit in $EDITOR        [s] Send & Archive")
  (displayln "  [a] Reply-All & Archive    [c] Cancel")
  (displayln "")
  (display "Action: ")
  (flush-output))

;; Sentinel line separating draft from original reference
(define ORIGINAL-SENTINEL "-- \nEdit above. Original for reference:\n")

;; Quote a string with > prefix on each line
(define (quote-lines text)
  (string-join
   (map (λ (line) (string-append "> " line))
        (string-split text "\n" #:trim? #f))
   "\n"))

;; Extract display name from a From: header value.
;; "Peter Danenberg <peter@...>"     → "Peter Danenberg"
;; "\"Peter Danenberg\" <peter@...>" → "Peter Danenberg"
;; "peter@danenberg.ai"              → "peter@danenberg.ai"
(define (extract-display-name header-value)
  (cond
    [(not header-value) ""]
    ;; Quoted display name: "Foo Bar" <addr>
    [(regexp-match #rx"^\"([^\"]+)\"[ ]*<" header-value)
     => (λ (m) (string-trim (cadr m)))]
    ;; Unquoted display name: Foo Bar <addr>
    [(regexp-match #rx"^([^<]+)<" header-value)
     => (λ (m) (string-trim (cadr m)))]
    [else (string-trim header-value)]))

;; Shorten an RFC 2822 date to "Thu, 19 Feb 2026" (or "19 Feb 2026" if no day-of-week).
;; Keeps tokens up to and including the 4-digit year.
(define (short-date date-str)
  (if (not date-str)
      ""
      (let* ([tokens (string-split date-str)]
             [year-idx (for/first ([t tokens] [i (in-naturals)]
                                  #:when (regexp-match? #px"^[0-9]{4}$" t))
                         i)])
        (if year-idx
            (string-join (take tokens (+ year-idx 1)) " ")
            (string-join (take tokens (min 4 (length tokens))) " ")))))

;; Build a prose attribution line for the quoted block
;; Produces: > *Peter Danenberg wrote on Thu, 19 Feb 2026:*
(define (make-attribution msg)
  (define name (extract-display-name (message-from msg)))
  (define date (short-date (message-date msg)))
  (format "> *~a wrote on ~a:*" name date))

;; Edit draft in $EDITOR, with original email appended for reference
;; Strips everything from the sentinel line downward before returning
(define (edit-in-editor draft msg)
  (define tmpfile "/tmp/schemail-draft.md")
  (define original-body (get-email-body msg))

  (with-output-to-file tmpfile
    #:exists 'replace
    (λ ()
      (display draft)
      (display "\n\n")
      (display ORIGINAL-SENTINEL)
      (display "\n")
      (display (make-attribution msg))
      (display "\n>\n")
      (display (quote-lines original-body))))
  
  (define editor (or (getenv "EDITOR") "nano"))
  (system (format "~a ~a" editor tmpfile))
  
  ;; Read back and strip sentinel + everything below
  (define full (with-input-from-file tmpfile
                 (λ () (port->string (current-input-port)))))
  (define sentinel-match (regexp-match-positions (regexp-quote ORIGINAL-SENTINEL) full))
  (define trimmed (if sentinel-match
                      (string-trim (substring full 0 (caar sentinel-match)) #:left? #f)
                      (string-trim full #:left? #f)))
  trimmed)

;; Compute reply envelope from message and user info
;; Always computes potential-cc for display purposes; cc is only used when sending reply-all
(define (make-envelope msg user-email user-display-name #:reply-all? [reply-all? #f])
  (define original-subject (message-subject msg))
  (define subject
    (if (string-prefix? original-subject "Re:")
        original-subject
        (string-append "Re: " original-subject)))
  ;; From: Delivered-To > To header > OAuth email
  (define reply-email (or (extract-address (message-delivered-to msg))
                          (extract-address (message-header msg "To"))
                          user-email))
  (define from (format-email-with-name reply-email user-display-name))
  ;; To: Reply-To if present, otherwise From
  (define to (or (message-header msg "Reply-To")
                 (message-from msg)))
  ;; Potential Cc: original To + Cc minus our address and the To: recipient
  ;; Keep decorated form for display/sending; use bare addresses only for filtering
  (define to-addr (extract-address to))
  (define potential-cc
    (let* ([all-decorated (append (split-addresses (message-header msg "To"))
                                  (split-addresses (message-header msg "Cc")))]
           [others (filter (λ (decorated)
                             (define addr (extract-address decorated))
                             (and addr
                                  (not (string-ci=? addr reply-email))
                                  (not (string-ci=? addr to-addr))))
                           all-decorated)])
      (and (not (null? others))
           (string-join others ", "))))
  ;; Cc only included when actually sending reply-all
  (hash 'from from 'to to 'cc (and reply-all? potential-cc)
        'potential-cc potential-cc
        'subject subject
        'thread-id (hash-ref msg 'threadId #f)
        'msg-id    (hash-ref msg 'id)))

;; Handle reply action
(define (handle-reply msg user-email user-display-name)
  (displayln "\nGenerating reply with Claude...")
  (flush-output)
  
  (define draft (draft-reply msg
                             #:user-email user-email
                             #:user-name (or user-display-name "")))
  
  (define envelope (make-envelope msg user-email user-display-name))

  (let loop ()
    (display-draft draft envelope)
    (define action (read-key))
    (displayln (format "\n~a" action))
    
    (case action
      [(#\e)
       (set! draft (edit-in-editor draft msg))
       (loop)]
      
      [(#\s #\a)
       (define env (if (char=? action #\a)
                       (make-envelope msg user-email user-display-name #:reply-all? #t)
                       envelope))
       (displayln (if (char=? action #\a) "\nSending reply-all..." "\nSending..."))
       (flush-output)
       (gmail-send-email
        #:from       (hash-ref env 'from)
        #:to         (hash-ref env 'to)
        #:cc         (hash-ref env 'cc #f)
        #:subject    (hash-ref env 'subject)
        #:body       draft
        #:thread-id  (hash-ref env 'thread-id #f)
        #:in-reply-to (hash-ref env 'msg-id))
       (displayln "✓ Sent")
       (displayln "Archiving...")
       (gmail-modify-message (hash-ref env 'msg-id) #:remove-labels '("INBOX"))
       (displayln "✓ Archived")
       'done]
      
      [(#\c)
       'cancelled]
      
      [else
       (loop)])))

;; Handle archive action
(define (handle-archive msg)
  (define msg-id (hash-ref msg 'id))
  (displayln "\nArchiving...")
  (gmail-modify-message msg-id #:remove-labels '("INBOX"))
  (displayln "✓ Archived"))

;; Main loop
(define (run-flow)
  (displayln "Schemail Flow - Interactive Email Processing")
  (displayln "Loading...")
  (displayln "")
  
  ;; Get OAuth token
  (get-gmail-token)
  
  ;; Get user email and display name
  (define user-email (gmail-get-user-email))
  (define user-display-name (people-get-display-name))
  (displayln (format "Logged in as: ~a~a" 
                     user-email
                     (if user-display-name 
                         (format " (~a)" user-display-name)
                         "")))
  (displayln "")
  
  ;; Fetch inbox messages (already processed/labeled by daemon)
  (displayln "Fetching emails from inbox...")
  (define messages-response 
    (gmail-list-messages #:query "in:inbox" 
                        #:max-results batch-size))
  
  (define message-ids 
    (map (λ (m) (hash-ref m 'id))
         (hash-ref messages-response 'messages '())))
  
  (when (empty? message-ids)
    (displayln "No messages found in inbox!")
    (exit 0))
  
  (displayln (format "Found ~a message(s)" (length message-ids)))
  (displayln "")
  
  ;; Fetch labels for display
  (define labels-response (gmail-list-labels))
  (define labels 
    (for/hash ([label (hash-ref labels-response 'labels '())])
      (values (hash-ref label 'id)
              (hash-ref label 'name))))
  
  ;; Process each message
  (for ([id message-ids]
        [i (in-naturals 1)])
    (define msg (gmail-get-message id))
    
    (let loop ()
      (display-email msg i (length message-ids) labels)
      (define action (read-key))
      (displayln (format "\n~a" action))
      
      (case action
        [(#\r)
         ;; Reply
         (define result (handle-reply msg user-email user-display-name))
         (when (eq? result 'cancelled)
           (loop))]
        
        [(#\a)
         ;; Archive
         (handle-archive msg)]
        
        [(#\s)
         ;; Skip
         (void)]
        
        [(#\q)
         ;; Quit
         (displayln "\nGoodbye!")
         (exit 0)]
        
        [else
         ;; Unknown key, loop
         (loop)])))
  
  (clear-screen)
  (displayln "╔════════════════════════════════════════════════════════════╗")
  (displayln "║  All Done!                                                 ║")
  (displayln "╚════════════════════════════════════════════════════════════╝")
  (displayln "")
  (displayln (format "Processed ~a emails" (length message-ids)))
  (displayln ""))

;; Entry point
(module+ main
  (run-flow))
